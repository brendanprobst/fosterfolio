# Supabase CLI + MCP credentials for THIS clone.
#
# Copy to `supabase/.env.local` (gitignored) and fill in real values.
# Loaded by `scripts/supabase-cli.mjs` for every `npm run supabase:*` command.
# Nothing here belongs in the API or web runtime env — those live in
# `apps/api/.env` and `apps/web/.env.local`.
#
# See docs/playbooks/supabase-migrations.md.

# Arm local schema push. Leave this at 0. `npm run supabase:push` refuses to
# change the remote database until you set it to 1, then set it back to 0.
SUPABASE_PUSH_ENABLED=0

# Project ref from the dashboard URL:
# https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=your-project-ref

# Personal access token: https://supabase.com/dashboard/account/tokens
# Read natively by the CLI, so `supabase login` is not required on this machine.
# Also consumed by the Supabase MCP server in `.cursor/mcp.json` — export both
# this and SUPABASE_PROJECT_REF in your shell profile for MCP to pick them up.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# Postgres URL for DDL (`npm run supabase:push`, `supabase:list`).
#
# Prefer the Session pooler from the dashboard Connect dialog (port 5432).
# Free-tier direct hosts (db.<ref>.supabase.co) are often IPv6-only and fail
# with ENOTFOUND on IPv4-only networks. Do NOT use the transaction pooler
# (port 6543) for migrations.
#
# Example (session pooler):
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# After `npm run supabase:link`, see supabase/.temp/pooler-url for this
# project's host/user (gitignored). URL-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-us-west-2.pooler.supabase.com:5432/postgres


