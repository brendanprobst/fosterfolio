# Copy to terraform.tfvars (gitignored) and fill with real values.
# Supabase: Project Settings → API (URL, anon, service_role); JWT secret under JWT Settings if needed.

project_name  = "my-lattice-app"
environment   = "dev"
aws_region    = "us-east-1"
# extra_tags = { Owner = "you@example.com" }

supabase_url                = "https://YOUR_PROJECT_REF.supabase.co"
supabase_anon_key           = "YOUR_ANON_KEY"
supabase_service_role_key   = "YOUR_SERVICE_ROLE_KEY"
# supabase_jwt_secret       = "YOUR_JWT_SECRET" # optional

manage_supabase_credentials_in_ssm = true

# API allowlist middleware (EMAIL_ALLOWLIST_ENABLED on Lambda). Defaults to true
# for private beta. Also run `select public.set_allowlist_enabled(true);` in Supabase
# and insert tester emails — see docs/playbooks/private-beta.md.
email_allowlist_enabled = true

# Phase 3 cost controls
# api_lambda_reserved_concurrency = 5 # optional; only if account has spare regional concurrency, so copying the example does not force reservation
api_gateway_throttling_rate_limit = 10
api_gateway_throttling_burst_limit = 20
# Optional: override the per-route limits on the unauthenticated routes (defaults in variables.tf).
# Any route you leave out of the map loses its own throttle and falls back to the stage default.
# api_gateway_public_route_throttles = {
#   "POST /inquiries"                            = { rate_limit = 1, burst_limit = 5 }
#   "PATCH /inquiries/{id}/self-reported-source" = { rate_limit = 1, burst_limit = 5 }
#   "GET /links/resolve/{code}"                  = { rate_limit = 2, burst_limit = 10 }
# }

enable_budget_alerts         = true
monthly_cost_budget_limit_usd = 10
budget_alert_email_addresses = ["you@example.com"]

# Optional scheduled pause/resume to minimize idle cost
enable_api_schedule_controls  = false
api_pause_schedule_expression = "cron(0 2 * * ? *)"
api_resume_schedule_expression = "cron(0 13 * * ? *)"
api_schedule_timezone         = "UTC"

# --- Optional: custom HTTPS hostname (Route 53 + ACM + CloudFront alias) ---
# See docs/playbooks/route53-custom-domain.md for registrar nameserver delegation.
#
# web_custom_domain            = "app.example.com"
# create_route53_hosted_zone   = true
# route53_zone_name            = "example.com"
#
# Or use an existing Route 53 zone in the same account:
# web_custom_domain          = "app.example.com"
# route53_hosted_zone_id     = "Z1234567890ABC"
#
# If DNS stays at third-party provider (e.g. Squarespace), disable Route 53 DNS management:
# web_custom_domain          = "app.example.com"
# manage_web_dns_in_route53  = false

# --- Optional: SES SMTP for Supabase Auth (enable in one environment only) ---
# enable_ses_smtp        = true
# ses_domain             = "example.com"
# ses_from_email         = "auth@example.com"
# ses_from_name          = "Example Team"
# supabase_access_token  = "sbp_..." # https://supabase.com/dashboard/account/tokens

# --- Optional: notification email (inquiries) via SES ---
# The address's domain must be verified in SES in aws_region (see enable_ses_smtp above).
# notification_email_from      = "notifications@example.com"
# notification_email_from_name = "Example"
