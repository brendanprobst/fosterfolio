{
  "name": "@lattice/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "prebuild:lambda": "npm run build -w @lattice/notifications",
    "build:lambda": "esbuild lambda.ts --bundle --platform=node --target=node22 --format=cjs --tsconfig=tsconfig.json --outfile=dist-lambda/index.js && esbuild analyticsRollup.ts --bundle --platform=node --target=node22 --format=cjs --tsconfig=tsconfig.json --outfile=dist-lambda/rollup.js",
    "start": "node ./dist/bin/www.js",
    "predev": "npm run build -w @lattice/notifications",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only ./bin/www.ts",
    "predev:prod": "npm run build -w @lattice/notifications",
    "dev:prod": "FOSTERFOLIO_ENV=prod ts-node-dev -r tsconfig-paths/register --respawn --transpile-only ./bin/www.ts",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.rollup.json"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1148.0",
    "@aws-sdk/client-ssm": "^3.1014.0",
    "@lattice/analytics": "*",
    "@lattice/notifications": "*",
    "@vendia/serverless-express": "^4.12.6",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "http-errors": "~1.6.3",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "chalk": "^4.1.2",
    "esbuild": "^0.27.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
