# Server Configuration
PORT=3000

# Supabase (optional for local dev — if omitted, API uses in-memory repositories; required for production)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT verification for API auth middleware
# Default: JWKS via SUPABASE_URL + issuer/audience (recommended)
# Optional legacy/test fallback: set SUPABASE_JWT_SECRET for HS256 verification.
# SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Browser origins allowed to call API (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Email allowlist (private beta). Off unless set to true or 1.
# AWS: Terraform `email_allowlist_enabled` (default true) sets this on Lambda.
# Also run `select public.set_allowlist_enabled(true);` — see docs/playbooks/private-beta.md
# EMAIL_ALLOWLIST_ENABLED=true
# ALLOWED_EMAILS_TABLE=allowed_emails

# Per-user media storage cap in bytes (Supabase Storage). Default 50MB.
# STORAGE_CAP_BYTES=52428800
# SUPABASE_MEDIA_BUCKET=fosterfolio-media

# Cloudflare Turnstile. Unset in Jest, Playwright, and local dev: inquiries are accepted with no token.
# Used for captcha verification on form submissions.
# TURNSTILE_SECRET_KEY=

# Signs the one-time inquiry source token. Set a private value before production.
# INQUIRY_SOURCE_TOKEN_SECRET=

# Outbound email for inquiries. Default: log (no send).
# EMAIL_PROVIDER=log
# EMAIL_PROVIDER=ses
# EMAIL_FROM=noreply@yourdomain.com
# AWS_REGION=us-west-2

# Hourly analytics rollup. On AWS, `npm run deploy:aws` reads these from Infisical
# `/fosterfolio/sensitive` and passes them to Terraform. Do not put the personal API key in GitHub.
# POSTHOG_HOST=https://us.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=

# Dev-only: accept expired JWTs on localhost when debugging stale tokens.
# NEVER set this on Lambda / production — it bypasses JWT expiry checks.
# AUTH_IGNORE_EXPIRATION_ON_LOCALHOST=true
